-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Run with mix --serve notify-bridge.mix. Children belong to this generation.
$max_children = to_number(env("NOTIFY_BRIDGE_MAX_CHILDREN", "20"))
if $max_children == nil or $max_children < 0 or $max_children > 20 or floor($max_children) != $max_children then
  raise("USAGE", "NOTIFY_BRIDGE_MAX_CHILDREN must be an integer from 0 to 20")
end
$signals = require("signals.mix")
$ids = {}
$reverse_ids = {}
$watch = nil
$owner_watch = nil
$children = {}
$backoff = {}
$started = {}
$pending_file = env("XDG_RUNTIME_DIR", env("HOME") .. "/.local/state/mixos") .. "/notify-bridge-pending.json"
if is_reload_candidate() and is_file($pending_file) then
  if length(json_parse(read_file($pending_file))) > 0 then
    raise("PRESENT_PENDING", "retry reload after notify-send has printed its id")
  end
end
$dbus = ["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path", "/org/freedesktop/Notifications", "--method"]

fn variant($value)
  return json_encode($value)
end

fn pending($children)
  $waiting = filter(keys($children), fn($w) = $children[$w].ref == nil)
  mkdir(dirname($pending_file), {parents: true})
  write_atomic($pending_file, json_encode($waiting))
end

fn close_ref($ref)
  if $ref == nil or starts_with($ref, "process:") then return end
  try
    $r = run_argv(concat($dbus, ["org.freedesktop.Notifications.CloseNotification", $ref]), {timeout: 5})
    if not $r.ok then eprint("notify-bridge: CloseNotification failed: " .. json_encode($r)) end
  catch $message
    eprint("notify-bridge: CloseNotification failed: " .. $message)
  end
end

fn remember($id, $ref)
  send notify notify.present body=json_encode({id: to_number($id), surface: "plasma", ref: $ref})
  if $rc != 0 then
    -- Never leave a visible copy without a durable reference.
    close_ref($ref)
    eprint("notify-bridge: notify.present failed for " .. $id)
    return false
  end
  return true
end

fn sender($n)
  if ($n.app ?? "") != "" then return $n.app end
  if ($n.source ?? "") != "" then return $n.source end
  return "MixOS"
end

fn show($n, $mapping, $child_count)
  $key = to_string($n.id)
  if $mapping[$key] != nil then return $mapping end
  $urgency = $n.urgency ?? "normal"
  $byte = if $urgency == "critical" then 2 elif $urgency == "low" then 0 else 1 end
  $actions = []
  for $a in $n.actions ?? []
    push($actions, $a.id)
    push($actions, $a.label)
  end
  if length($actions) > 0 and $child_count < $max_children then
    -- Plasma removes actions when their D-Bus sender disconnects. Keep
    -- libnotify's connection alive in a generation-owned child until close.
    $command = ["notify-send", "--wait", "--print-id", "--app-name", sender($n),
      "--icon", "dev.mixos.tray", "--urgency", $urgency, "--expire-time", "0",
      "--hint", "boolean:resident:true", "--hint", "string:x-kde-origin-name:MixOS"]
    for $a in $n.actions
      $command = concat($command, ["--action", $a.id .. "=" .. $a.label])
    end
    $command = concat($command, ["--", $n.summary, $n.body ?? ""])
    $mapping[$key] = process_watch($command, {tag: "toast", stderr: "inherit"})
    return $mapping
  end
  if length($actions) > 0 then
    eprint("notify-bridge: question child cap reached; plain toast for " .. $key)
    $actions = []
  end
  -- Explicit as keeps even the empty list typed. Do not invent a default
  -- action: Plasma treats that key as clicking the toast, not a button.
  $resident = $urgency == "critical"
  $hints = "{'urgency': <byte " .. to_string($byte) .. ">, 'x-kde-origin-name': <'MixOS'>, 'resident': <" .. to_string($resident) .. ">}"
  $notify_argv = concat($dbus, ["org.freedesktop.Notifications.Notify",
    variant(sender($n)), "0", "dev.mixos.tray",
    variant($n.summary), variant($n.body ?? ""), "@as " .. variant($actions),
    $hints, "0"])
  $r = run_argv($notify_argv, {timeout: 5})
  $matches = re_find($r.stdout, "uint32 ([0-9]+)")
  if not $r.ok or length($matches) != 1 then
    eprint("notify-bridge: Notify failed: " .. json_encode($r))
    return $mapping
  end
  $plasma = $matches[0].groups[0]
  if not remember($key, $plasma) then return $mapping end
  $mapping[$key] = $plasma
  print("notify-bridge: mapped " .. $key .. " -> " .. $plasma)
  return $mapping
end

fn invert($mapping)
  $back = {}
  for $key in keys($mapping)
    if $mapping[$key] != nil and not starts_with($mapping[$key], "process:") then $back[$mapping[$key]] = $key end
  end
  return $back
end

fn start_watch()
  return process_watch(["gdbus", "monitor", "--session", "--dest", "org.freedesktop.Notifications"], {tag: "notifications", stderr: "inherit"})
end

fn start_owner_watch()
  -- Opt-in stdout fixture for testing owner changes without touching Plasma.
  $fixture = env("NOTIFY_BRIDGE_OWNER_FIXTURE", "")
  if $fixture != "" then
    return process_watch(["/opt/mixos/bin/mix", $fixture], {tag: "owners", stderr: "inherit"})
  end
  return process_watch(["gdbus", "monitor", "--session", "--dest", "org.freedesktop.DBus"], {tag: "owners", stderr: "inherit"})
end

fn reconcile($mapping, $children, $close_saved)
  send notify notify.list
  if $rc != 0 then
    eprint("notify-bridge: notify.list failed")
    return {ids: $mapping, children: $children}
  end
  $records = $result
  if $close_saved then
    for $n in $records
      close_ref(($n.presented ?? {}).plasma)
    end
  end
  for $n in $records
    $mapping = show($n, $mapping, length($children))
    -- Count each spawned child before deciding how to show the next record.
    $children = track($mapping, $children)
  end
  return {ids: $mapping, children: $children}
end

fn track($mapping, $tracked)
  for $key in keys($mapping)
    $ref = $mapping[$key]
    if starts_with($ref, "process:") and $tracked[$ref] == nil then
      $tracked[$ref] = {id: $key, ref: nil}
    end
  end
  pending($tracked)
  return $tracked
end

on lifecycle.commit
  subscribe("notify.changed")
  $watch = start_watch()
  $owner_watch = start_owner_watch()
  $started[$watch] = time()
  $started[$owner_watch] = time()
  $reconciled = reconcile($ids, $children, true)
  $ids = $reconciled.ids
  $children = $reconciled.children
  $children = track($ids, $children)
  $reverse_ids = invert($ids)
end

on notification.created
  $ids = show(json_parse($event.body), $ids, length($children))
  $children = track($ids, $children)
  $reverse_ids = invert($ids)
end

on notification.answered
  $n = json_parse($event.body)
  $key = to_string($n.id)
  if $ids[$key] != nil then
    close_ref($ids[$key])
    $ids = delete($ids, $key)
    $reverse_ids = invert($ids)
  end
end

on notification.closed
  $n = json_parse($event.body)
  $key = to_string($n.id)
  if $ids[$key] != nil then
    close_ref($ids[$key])
    $ids = delete($ids, $key)
    $reverse_ids = invert($ids)
  end
end

on proc.line
  $line = $event.args
  if $children[$line.watch] != nil and not $line.truncated then
    $key = $children[$line.watch].id
    if re_match($line.line, "^[0-9]+$") and $children[$line.watch].ref == nil then
      $children[$line.watch].ref = $line.line
      pending($children)
      if not remember($key, $line.line) then
        $ids = delete($ids, $key)
        $reverse_ids = invert($ids)
        return
      end
      $ids[$key] = $line.line
      print("notify-bridge: mapped " .. $key .. " -> " .. $line.line)
      -- An outcome can arrive before notify-send prints its Plasma id.
      send notify notify.get body=json_encode({id: to_number($key)})
      if $rc == 0 and $result.status == "done" then
        close_ref($line.line)
        $ids = delete($ids, $key)
      end
    elif trim($line.line) != "" then
      -- libnotify prints the chosen key, even when the click precedes its id.
      send notify notify.action body=json_encode({id: to_number($key), action: $line.line})
    end
    $reverse_ids = invert($ids)
  end
  if $line.watch == $watch and not $line.truncated then
    $action = $signals.parse_action($line.line)
    $closed = re_find($line.line, "org.freedesktop.Notifications.NotificationClosed \\(uint32 ([0-9]+), uint32 ([0-9]+)\\)")
    if $action != nil then
      $id = $reverse_ids[$action.ref]
      if $id != nil then
        send notify notify.action body=json_encode({id: to_number($id), action: $action.key})
      end
    elif length($closed) == 1 then
      $g = $closed[0].groups
      $id = $reverse_ids[$g[0]]
      if $id != nil then
        $ids = delete($ids, $id)
        $reverse_ids = invert($ids)
        if $g[1] == "2" then
          send notify notify.dismiss body=json_encode({id: to_number($id)})
        end
      end
    end
  end
  $new_owner = if $line.watch == $owner_watch and not $line.truncated then $signals.owner_changed($line.line) else nil end
  if $new_owner != nil then
    -- The old ids belong to a dead server. Never close them on the new owner.
    for $child in keys($children)
      $ignored = process_unwatch($child)
    end
    $children = {}
    pending($children)
    $ids = {}
    $reverse_ids = {}
    if $new_owner != "" then
      $reconciled = reconcile($ids, $children, false)
      $ids = $reconciled.ids
      $children = $reconciled.children
      $reverse_ids = invert($ids)
    end
  end
end

on proc.overflow
  eprint("notify-bridge: signal queue overflow: " .. $event.body)
end

on proc.watch_exited
  $handle = $event.args.watch
  if $children[$handle] != nil then
    $key = $children[$handle].id
    $ids = delete($ids, $key)
    $reverse_ids = invert($ids)
    $children = delete($children, $handle)
    pending($children)
    -- No stdout action and no reason-2 signal means no inferred human choice.
  end
  if $handle == $watch or $handle == $owner_watch then
    $delay = $signals.monitor_delay($started[$handle] ?? time(), time(), $backoff[$event.args.tag])
    $backoff[$event.args.tag] = min(30, $delay * 2)
    $started = delete($started, $handle)
    eprint("notify-bridge: monitor exited; restarting in " .. to_string($delay) .. "s")
    task_start("monitor.restart", json_encode({watch: $handle, delay: $delay}))
  end
end

on monitor.restart async
  sleep($event.args.delay)
end

on monitor.restart
  $handle = $event.args.watch
  if $handle == $watch then
    $watch = start_watch()
    $started[$watch] = time()
  elif $handle == $owner_watch then
    $owner_watch = start_owner_watch()
    $started[$owner_watch] = time()
  end
end

on @.status
  reply(json_encode({ids: $ids, reverse_ids: $reverse_ids, children: $children, watch: $watch, owner_watch: $owner_watch}))
end

if not is_reload_candidate() then
  subscribe("notify.changed")
  $watch = start_watch()
  $owner_watch = start_owner_watch()
  $started[$watch] = time()
  $started[$owner_watch] = time()
  $reconciled = reconcile($ids, $children, true)
  $ids = $reconciled.ids
  $children = $reconciled.children
  pending($children)
  $reverse_ids = invert($ids)
end
